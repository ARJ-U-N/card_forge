rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// Workspace isolation: every document is scoped to a workspace and only
// members of that workspace may read/write it. Passwords never touch Firestore.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;
    }

    function isWorkspaceOwner(workspaceId) {
      return signedIn()
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    // ── Validate common field constraints ──
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidString(field, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLen;
    }

    // ── Users ──
    match /users/{uid} {
      allow read: if isSelf(uid) || isWorkspaceMember(resource.data.workspaceId);
      allow create: if isSelf(uid)
        && request.resource.data.authUid == uid
        && request.resource.data.email == request.auth.token.email
        && isValidString('email', 320);
      allow update: if isSelf(uid)
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // ── Check if a folder is submitted/locked ──
    // Uses EXISTING document state (resource.data) so the initial
    // submit write (setting submittedAt) is allowed.
    function isFolderSubmitted(workspaceId, folderId) {
      return 'submittedAt' in get(/databases/$(database)/documents/workspaces/$(workspaceId)/folders/$(folderId)).data
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)/folders/$(folderId)).data.submittedAt != null;
    }

    // ── Workspaces ──
    match /workspaces/{workspaceId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && isValidString('name', 100);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      // ── Members (workspace subcollection) ──
      match /members/{memberId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && isValidString('firstName', 150)
          && isValidString('lastName', 150)
          && (isWorkspaceOwner(workspaceId) || !isFolderSubmitted(workspaceId, request.resource.data.folderId));
        allow update: if isWorkspaceMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && (isWorkspaceOwner(workspaceId) || !isFolderSubmitted(workspaceId, resource.data.folderId));
        allow delete: if isWorkspaceMember(workspaceId)
          && (isWorkspaceOwner(workspaceId) || !isFolderSubmitted(workspaceId, resource.data.folderId));
      }

      // ── Folders (workspace subcollection) ──
      // For the main folder itself: check resource.data.submittedAt (current state)
      // so the initial submit (setting submittedAt) is allowed.
      // For subfolders: check the parent folder's lock state.
      match /folders/{folderId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && isValidString('name', 100)
          && (isWorkspaceOwner(workspaceId)
            || request.resource.data.parentFolderId == null
            || !isFolderSubmitted(workspaceId, request.resource.data.parentFolderId));
        allow update: if isWorkspaceMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && (isWorkspaceOwner(workspaceId)
            || !('submittedAt' in resource.data) || resource.data.submittedAt == null);
        allow delete: if isWorkspaceMember(workspaceId)
          && (isWorkspaceOwner(workspaceId)
            || !('submittedAt' in resource.data) || resource.data.submittedAt == null);
      }

      // ── Designs (workspace subcollection) ──
      match /designs/{designId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && isValidString('name', 200)
          && (isWorkspaceOwner(workspaceId)
            || request.resource.data.folderId == null
            || !isFolderSubmitted(workspaceId, request.resource.data.folderId));
        allow update: if isWorkspaceMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && (isWorkspaceOwner(workspaceId)
            || resource.data.folderId == null
            || !isFolderSubmitted(workspaceId, resource.data.folderId));
        allow delete: if isWorkspaceMember(workspaceId)
          && (isWorkspaceOwner(workspaceId)
            || resource.data.folderId == null
            || !isFolderSubmitted(workspaceId, resource.data.folderId));
      }

      // ── Assets (workspace subcollection) ──
      match /assets/{assetId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && isValidString('name', 255)
          && request.resource.data.sizeBytes is number
          && request.resource.data.sizeBytes <= 10485760;
        allow update: if isWorkspaceMember(workspaceId);
        allow delete: if isWorkspaceMember(workspaceId);
      }

      // ── Other subcollections (departments, jobs, etc.) ──
      match /{subcollection}/{docId} {
        allow read, write: if isWorkspaceMember(workspaceId)
          && !(subcollection in ['members', 'folders', 'designs', 'assets']);
      }
    }

    // ── Portals ──
    // Portal read is public (for token-based access).
    // Only workspace members can create/update their workspace's portal.
    // Portal documents are keyed by folderId (one portal per main College folder).
    // PIN hash is validated server-side; never store plaintext.
    match /portals/{portalId} {
      allow read: if true;
      allow create, update: if signedIn()
        && isWorkspaceMember(request.resource.data.workspaceId)
        && request.resource.data.keys().hasAll(['pinHash', 'portalToken', 'enabled', 'folderId'])
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.size() == 64;
      allow delete: if signedIn()
        && isWorkspaceOwner(resource.data.workspaceId);
    }

    // ── Templates ──
    // All signed-in users can read. Only authenticated users can create.
    match /templates/{templateId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isValidString('name', 200);
      allow delete: if false;
    }

    // ── Deny-all fallback ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
